{
  "name": "@agent-dispatch/mcp-server",
  "version": "0.1.4",
  "description": "Provider-neutral MCP server for AgentDispatch.",
  "keywords": [
    "agentdispatch",
    "mcp",
    "model-context-protocol",
    "cloud-agents",
    "subagents",
    "ai-agents",
    "aws-agentcore",
    "typescript"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "agentdispatch-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@agent-dispatch/core": "^0.1.0"
  },
  "dependencies": {
    "@agent-dispatch/adapter-aws-agentcore": "^0.1.0",
    "@agent-dispatch/store-sqlite": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@agent-dispatch/core": "^0.1.0",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-dispatch/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/agent-dispatch/mcp-server/issues"
  },
  "homepage": "https://github.com/agent-dispatch/mcp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  }
}
