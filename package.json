{
  "name": "@agentdispatch/mcp-server",
  "version": "0.1.0",
  "description": "Provider-neutral MCP server for AgentDispatch.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "agentdispatch-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@agentdispatch/core": "^0.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@agentdispatch/core": "file:../agentdispatch-core",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
